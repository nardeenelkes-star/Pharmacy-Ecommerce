
@model IEnumerable<Pharmacy.DAL.Entities.DriverOrder>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    <h2 class="mb-4">My Delivery Orders</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any assigned orders yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer Name</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th>Amount Due</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderId</td>
                            <td>@order.ShippingName</td>
                            <td>@order.ShippingPhone</td>
                            <td>
                                @order.ShippingGovernorate,
                                @order.ShippingCity,
                                @order.ShippingStreet,
                                Building @order.ShippingBuildingNumber
                            </td>
                            <td>@order.Status</td>
                            <td>
                                @(order.CodAmount?.ToString("0.00") ?? "N/A")
                            </td>
                            <td>
                                <a asp-controller="Driver"
                                   asp-action="Details"
                                   asp-route-id="@order.OrderId"
                                   class="btn btn-primary btn-sm">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
